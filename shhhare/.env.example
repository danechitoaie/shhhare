# Storage backend: redis | cloudflare-kv
STORAGE=redis

# --- Redis (required when STORAGE=redis) ---
REDIS_URL=...

# --- Cloudflare KV (required when STORAGE=cloudflare-kv) ---
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_KV_NAMESPACE_ID=...
# CLOUDFLARE_API_TOKEN=...

# Size
# Case-insensitive with KB/MB/GB treated as decimal (1000-based)
# and KiB/MiB/GiB as binary (1024-based), per IEC convention
MAX_SIZE=...
